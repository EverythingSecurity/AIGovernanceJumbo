{
  "title": "Client engagement layer",
  "version": 1,
  "description": "Scoping questionnaire, applicability rules and the engagement pipeline. Rules and questions are data: edit them here or add custom rules to a scope file.",
  "client_statuses": ["invited", "onboarded"],
  "sizes": ["micro", "small", "medium", "large"],
  "sectors": ["telecom", "banking", "insurance", "health", "public_sector", "critical_infrastructure", "technology", "other"],
  "confidence": ["low", "medium", "high"],
  "questionnaire": {
    "version": 1,
    "domains": [
      {"id": "jurisdiction", "name": "Jurisdiction and geography"},
      {"id": "industry", "name": "Industry and sector"},
      {"id": "regulated", "name": "Regulated entity status"},
      {"id": "data", "name": "Data profile"},
      {"id": "ai", "name": "AI usage"},
      {"id": "technology", "name": "Technology and third parties"},
      {"id": "certifications", "name": "Certifications and contractual requirements"},
      {"id": "organisation", "name": "Organisation size and maturity"}
    ],
    "questions": [
      {"id": "j_countries", "domain": "jurisdiction", "kind": "multi", "required": true,
       "text": "Which regions does the company operate in?",
       "options": ["eu", "uk", "us", "qatar", "other_gcc", "other"]},
      {"id": "j_customer_locations", "domain": "jurisdiction", "kind": "multi", "required": true,
       "text": "Where are your customers or data subjects located?",
       "options": ["eu", "uk", "us", "qatar", "other_gcc", "other"]},
      {"id": "j_data_residency", "domain": "jurisdiction", "kind": "single", "required": false,
       "text": "Is there a data residency requirement?",
       "options": ["in_country", "regional", "none"]},
      {"id": "i_sector", "domain": "industry", "kind": "single", "required": true,
       "text": "Which sector best describes the company?",
       "options": ["telecom", "banking", "insurance", "health", "public_sector", "critical_infrastructure", "technology", "other"]},
      {"id": "r_financial_entity", "domain": "regulated", "kind": "yes_no", "required": true,
       "text": "Is the company a financial entity regulated in the EU (for example a bank, insurer or payment institution)?"},
      {"id": "r_ict_provider_to_fe", "domain": "regulated", "kind": "yes_no", "required": true,
       "text": "Does the company provide ICT services to EU financial entities?"},
      {"id": "r_essential_service", "domain": "regulated", "kind": "yes_no", "required": true,
       "text": "Is the company an operator of essential services or critical infrastructure?"},
      {"id": "r_sector_licensed", "domain": "regulated", "kind": "yes_no", "required": false,
       "text": "Does the company hold a sector licence that sets its own security or conduct rules?"},
      {"id": "d_personal", "domain": "data", "kind": "yes_no", "required": true,
       "text": "Does the company process personal data?"},
      {"id": "d_special", "domain": "data", "kind": "yes_no", "required": true,
       "text": "Does it process special-category data (health, biometric, children, and similar)?"},
      {"id": "d_payment", "domain": "data", "kind": "yes_no", "required": false,
       "text": "Does it process payment card data?"},
      {"id": "d_cross_border", "domain": "data", "kind": "yes_no", "required": false,
       "text": "Is personal data transferred across borders?"},
      {"id": "d_volume", "domain": "data", "kind": "single", "required": true,
       "text": "How large is the volume of personal or sensitive data?",
       "options": ["small", "medium", "large"]},
      {"id": "a_role", "domain": "ai", "kind": "multi", "required": true,
       "text": "How does the company use AI?",
       "options": ["develop", "deploy", "procure", "none"]},
      {"id": "a_eu_market", "domain": "ai", "kind": "yes_no", "required": true,
       "text": "Is AI placed on, or used in, the EU market?"},
      {"id": "a_gpai", "domain": "ai", "kind": "yes_no", "required": false,
       "text": "Does it build or integrate general-purpose AI models?"},
      {"id": "a_automated_decisions", "domain": "ai", "kind": "yes_no", "required": false,
       "text": "Does AI make or support automated decisions about people?"},
      {"id": "a_risk", "domain": "ai", "kind": "single", "required": false,
       "text": "What is the highest risk level of the AI use cases?",
       "options": ["minimal", "limited", "high", "unknown"]},
      {"id": "t_cloud", "domain": "technology", "kind": "yes_no", "required": true,
       "text": "Does the company rely on cloud services?"},
      {"id": "t_outsourcing", "domain": "technology", "kind": "yes_no", "required": true,
       "text": "Does it outsource ICT or AI functions to third parties?"},
      {"id": "t_critical_vendors", "domain": "technology", "kind": "yes_no", "required": false,
       "text": "Does it depend on vendors whose failure would stop critical services?"},
      {"id": "t_apis", "domain": "technology", "kind": "yes_no", "required": false,
       "text": "Does it expose or consume external APIs?"},
      {"id": "c_needs_cert", "domain": "certifications", "kind": "yes_no", "required": true,
       "text": "Does the company need to hold, or want, a security certification?"},
      {"id": "c_contract_standards", "domain": "certifications", "kind": "multi", "required": false,
       "text": "Do customer contracts mandate any of these standards?",
       "options": ["iso-27001", "iso-27701", "iso-42001", "nist-ai-rmf", "eu-ai-act", "gdpr", "dora", "owasp-llm"]},
      {"id": "o_size", "domain": "organisation", "kind": "single", "required": true,
       "text": "How large is the organisation?",
       "options": ["micro", "small", "medium", "large"]},
      {"id": "o_maturity", "domain": "organisation", "kind": "single", "required": false,
       "text": "How mature are its security and governance practices?",
       "options": ["initial", "developing", "established", "advanced"]}
    ]
  },
  "rules": [
    {"id": "R-DORA", "framework": "dora", "confidence": "high", "weight": 90,
     "rationale": "EU financial entity, or ICT provider to one, so DORA is likely to apply.",
     "when": {"any": [{"q": "r_financial_entity", "op": "is", "value": "yes"}, {"q": "r_ict_provider_to_fe", "op": "is", "value": "yes"}]}},
    {"id": "R-PDPPL", "framework": "qatar-pdppl", "confidence": "high", "weight": 80,
     "rationale": "Processes personal data of people in Qatar, so Qatar's personal data protection law is likely to apply.",
     "when": {"all": [{"q": "d_personal", "op": "is", "value": "yes"}, {"q": "j_customer_locations", "op": "has", "value": "qatar"}]}},
    {"id": "R-GDPR", "framework": "gdpr", "confidence": "high", "weight": 85,
     "rationale": "Processes personal data of people in the EU, so GDPR is likely to apply.",
     "when": {"all": [{"q": "d_personal", "op": "is", "value": "yes"},
                      {"any": [{"q": "j_countries", "op": "has", "value": "eu"}, {"q": "j_customer_locations", "op": "has", "value": "eu"}]}]}},
    {"id": "R-AI-42001", "framework": "iso-42001", "confidence": "high", "weight": 70,
     "rationale": "Develops or deploys AI systems, so an AI management system standard fits.",
     "when": {"q": "a_role", "op": "in", "value": ["develop", "deploy"]}},
    {"id": "R-AI-NIST", "framework": "nist-ai-rmf", "confidence": "medium", "weight": 50,
     "rationale": "Develops or deploys AI systems, so an AI risk management framework helps.",
     "when": {"q": "a_role", "op": "in", "value": ["develop", "deploy"]}},
    {"id": "R-EUAI", "framework": "eu-ai-act", "confidence": "high", "weight": 85,
     "rationale": "AI is placed on, or used in, the EU market, so the EU AI Act is likely to apply.",
     "when": {"all": [{"q": "a_eu_market", "op": "is", "value": "yes"}, {"q": "a_role", "op": "in", "value": ["develop", "deploy", "procure"]}]}},
    {"id": "R-27001", "framework": "iso-27001", "confidence": "high", "weight": 60,
     "rationale": "Needs or wants a security certification, and ISO 27001 is the usual one.",
     "when": {"q": "c_needs_cert", "op": "is", "value": "yes"}},
    {"id": "R-DATAGOV", "framework": "data-governance", "confidence": "medium", "weight": 40,
     "rationale": "Large volume of personal or sensitive data, so a data governance framework fits.",
     "when": {"all": [{"q": "d_volume", "op": "is", "value": "large"},
                      {"any": [{"q": "d_personal", "op": "is", "value": "yes"}, {"q": "d_special", "op": "is", "value": "yes"}]}]}},
    {"id": "R-CONTRACT", "from_answer": "c_contract_standards", "confidence": "high", "weight": 75,
     "rationale": "A customer contract mandates this standard."}
  ]
}
