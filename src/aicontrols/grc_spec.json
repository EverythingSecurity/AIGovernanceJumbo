{
  "title": "GRC_Management_Framework",
  "version": "1.0.0",
  "description": "Declarative model of the GRC management framework: registers, evidence types, roles, ISO/IEC 42001 streams, lifecycle, artifacts and KPI/KRI targets. Read by src/aicontrols/grc.py and site/grc.js.",
  "registers": {
    "documents": {
      "title": "Policy, guideline and SOP library", "singular": "document", "id_prefix": "DOC",
      "fields": [
        {"name": "type", "label": "Type", "kind": "enum", "values": ["policy", "guideline", "sop"], "required": true},
        {"name": "title", "label": "Title", "kind": "text", "required": true},
        {"name": "owner", "label": "Owner", "kind": "text", "required": true},
        {"name": "version", "label": "Version", "kind": "text"},
        {"name": "status", "label": "Status", "kind": "enum", "values": ["draft", "approved", "retired"], "default": "draft"},
        {"name": "approved", "label": "Approved on", "kind": "date"},
        {"name": "review_months", "label": "Review every (months)", "kind": "int", "min": 1, "default": 12},
        {"name": "next_review", "label": "Next review", "kind": "date"},
        {"name": "url", "label": "Link", "kind": "text"}
      ]
    },
    "risks": {
      "title": "Risk register by business unit and department", "singular": "risk", "id_prefix": "RSK",
      "fields": [
        {"name": "title", "label": "Risk", "kind": "text", "required": true},
        {"name": "business_unit", "label": "Business unit", "kind": "text", "required": true},
        {"name": "department", "label": "Department", "kind": "text"},
        {"name": "owner", "label": "Risk owner", "kind": "text", "required": true},
        {"name": "description", "label": "Description", "kind": "text"},
        {"name": "inherent", "label": "Inherent rating", "kind": "enum", "values": ["low", "medium", "high", "critical"]},
        {"name": "residual", "label": "Residual rating", "kind": "enum", "values": ["low", "medium", "high", "critical"], "required": true},
        {"name": "treatment_plan", "label": "Treatment plan", "kind": "text"},
        {"name": "treatment_status", "label": "Treatment status", "kind": "enum", "values": ["none", "planned", "in_progress", "done"], "default": "none"},
        {"name": "status", "label": "Status", "kind": "enum", "values": ["open", "accepted", "closed"], "default": "open"},
        {"name": "reviewed", "label": "Last reviewed", "kind": "date"}
      ]
    },
    "findings": {
      "title": "Audit findings tracker", "singular": "finding", "id_prefix": "FND",
      "fields": [
        {"name": "title", "label": "Finding", "kind": "text", "required": true},
        {"name": "severity", "label": "Severity", "kind": "enum", "values": ["low", "medium", "high", "critical"], "required": true},
        {"name": "source", "label": "Source", "kind": "enum", "values": ["internal", "external"], "required": true},
        {"name": "control", "label": "Control or requirement", "kind": "text"},
        {"name": "owner", "label": "Owner", "kind": "text", "required": true},
        {"name": "raised", "label": "Raised on", "kind": "date", "required": true},
        {"name": "due", "label": "Due", "kind": "date", "required": true},
        {"name": "status", "label": "Status", "kind": "enum", "values": ["open", "closed"], "default": "open"},
        {"name": "closed", "label": "Closed on", "kind": "date"},
        {"name": "corrective_action", "label": "Corrective action", "kind": "text"}
      ]
    },
    "audits": {
      "title": "Audit plan", "singular": "audit", "id_prefix": "AUD",
      "fields": [
        {"name": "title", "label": "Audit or review", "kind": "text", "required": true},
        {"name": "kind", "label": "Kind", "kind": "enum", "values": ["internal", "external", "management_review"], "required": true},
        {"name": "scope", "label": "Scope", "kind": "text"},
        {"name": "auditor", "label": "Auditor or chair", "kind": "text"},
        {"name": "planned", "label": "Planned for", "kind": "date", "required": true},
        {"name": "completed", "label": "Completed on", "kind": "date"},
        {"name": "result", "label": "Result", "kind": "text"}
      ]
    },
    "scope_items": {
      "title": "Scope register", "singular": "scope item", "id_prefix": "SCP",
      "fields": [
        {"name": "kind", "label": "Kind", "kind": "enum", "values": ["business_unit", "department", "system", "ai_system", "data_set", "location", "legal_entity", "third_party", "regulation", "exclusion"], "required": true},
        {"name": "name", "label": "Name", "kind": "text", "required": true},
        {"name": "owner", "label": "Owner", "kind": "text"},
        {"name": "justification", "label": "Justification (required for exclusions)", "kind": "text"}
      ]
    },
    "evidence_sources": {
      "title": "Evidence sources", "singular": "evidence source", "id_prefix": "EVS",
      "fields": [
        {"name": "type", "label": "Evidence type", "kind": "text", "required": true},
        {"name": "source", "label": "Source system", "kind": "text", "required": true},
        {"name": "frequency", "label": "Frequency", "kind": "enum", "values": ["continuous", "daily", "weekly", "monthly", "quarterly", "annual", "per_release"], "required": true}
      ]
    }
  },
  "evidence_defaults": [
    {"type": "Access reviews", "source": "IAM / PAM", "frequency": "quarterly"},
    {"type": "Vulnerability and config state", "source": "Scanners / CSPM", "frequency": "continuous"},
    {"type": "Security events", "source": "SIEM", "frequency": "continuous"},
    {"type": "Pipeline gate results", "source": "CI/CD", "frequency": "per_release"},
    {"type": "Policy attestations", "source": "GRC platform", "frequency": "annual"}
  ],
  "roles": [
    {"id": "board_executive", "name": "Board / Executive", "responsibility": "Risk appetite, oversight", "workflow_roles": ["EXECUTIVE_APPROVER"]},
    {"id": "ciso_grc", "name": "CISO / Head of GRC", "responsibility": "Framework ownership, reporting", "workflow_roles": ["SCOPING_COMPLIANCE_LEAD", "COMPLIANCE_ARCHITECT", "SECOND_LINE_RISK_MANAGER"]},
    {"id": "business_heads", "name": "BU / Department heads", "responsibility": "Risk ownership, scope input", "workflow_roles": []},
    {"id": "control_owners", "name": "Control owners", "responsibility": "Implementation and evidence", "workflow_roles": ["FIRST_LINE_CONTROL_OWNER"]},
    {"id": "architecture_security", "name": "Architecture / Security", "responsibility": "Guidelines and technical standards", "workflow_roles": []},
    {"id": "internal_audit", "name": "Internal audit", "responsibility": "Independent assurance", "workflow_roles": ["THIRD_LINE_AUDITOR"]}
  ],
  "streams": [
    {"id": "leadership", "name": "Leadership", "focus": "Governance, accountability, AI policy commitment, context", "delivered_through": "Governance forum, charter",
     "refs": ["4.1", "4.3", "4.4", "5.*", "6.2", "6.3", "7.*", "9.*", "10.*", "A.3.*"]},
    {"id": "technology", "name": "Technology", "focus": "Secure development (SDL/SDLC), model lifecycle, CI/CD", "delivered_through": "Pipeline controls, gates",
     "refs": ["6.1.*", "8.*", "A.4.*", "A.6.*"]},
    {"id": "policy", "name": "Policy", "focus": "Annex A policies and objectives", "delivered_through": "Policy library",
     "refs": ["A.2.*", "A.9.*"]},
    {"id": "requirements", "name": "Requirements", "focus": "Legal, regulatory, customer and internal requirements", "delivered_through": "Requirements register",
     "refs": ["4.2", "A.5.*", "A.8.*", "A.10.*"]},
    {"id": "data_quality", "name": "Data quality (DQ)", "focus": "Data provenance, quality, bias and privacy", "delivered_through": "Data governance controls",
     "refs": ["A.7.*", "A.4.3"]}
  ],
  "lifecycle": [
    {"n": 1, "id": "identify", "title": "Identify applicable frameworks and obligations"},
    {"n": 2, "id": "scope", "title": "Scope business units, systems and data"},
    {"n": 3, "id": "decompose", "title": "Decompose into requirements and clauses"},
    {"n": 4, "id": "map", "title": "Map to controls, policies, guidelines and SOPs"},
    {"n": 5, "id": "assess", "title": "Assess gaps and risks, record owners"},
    {"n": 6, "id": "implement", "title": "Implement and treat risks"},
    {"n": 7, "id": "evidence", "title": "Collect evidence, ideally automated"},
    {"n": 8, "id": "audit", "title": "Audit internally, then externally"},
    {"n": 9, "id": "report", "title": "Report to leadership with KPIs"},
    {"n": 10, "id": "improve", "title": "Improve through corrective actions and management review"}
  ],
  "artifacts": [
    {"id": "inventory", "title": "Framework and regulation inventory"},
    {"id": "scopes", "title": "Scope statements per framework"},
    {"id": "requirements", "title": "Requirements and clause register"},
    {"id": "controls", "title": "Control library"},
    {"id": "matrix", "title": "Requirement-to-control mapping matrix"},
    {"id": "library", "title": "Policy, guideline and SOP library"},
    {"id": "risks", "title": "Risk register by BU and department"},
    {"id": "evidence", "title": "Evidence repository and SIEM integrations"},
    {"id": "kpis", "title": "KPI dashboard"},
    {"id": "audit", "title": "Audit plan and findings tracker"}
  ],
  "kpis": [
    {"id": "requirements_mapped", "name": "% requirements mapped to controls", "type": "KPI", "unit": "%", "op": ">=", "target": 100, "target_text": "100%"},
    {"id": "controls_current_evidence", "name": "% controls with current evidence", "type": "KPI", "unit": "%", "op": ">=", "target": 95, "target_text": "at least 95%"},
    {"id": "findings_past_due_critical", "name": "Open audit findings past due (critical)", "type": "KRI", "unit": "", "op": "==", "target": 0, "target_text": "0 critical"},
    {"id": "policy_review_currency", "name": "Policy review currency", "type": "KPI", "unit": "%", "op": ">=", "target": 100, "target_text": "100% within cycle"},
    {"id": "risks_above_appetite", "name": "Risks above appetite without treatment plan", "type": "KRI", "unit": "", "op": "==", "target": 0, "target_text": "0"},
    {"id": "cross_framework_coverage", "name": "Cross-framework coverage", "type": "KPI", "unit": "%", "op": null, "target": null, "target_text": "per the coverage method"}
  ],
  "settings_defaults": {
    "anchor_framework": "iso-42001",
    "risk_appetite": "moderate",
    "mapping_review_months": 12,
    "scope_review_months": 12
  },
  "open_items": [
    {"n": 1, "text": "\"Ark\" under Operations was read as Risk.", "handled": "The risk register is organised by business unit and department."},
    {"n": 2, "text": "\"work\" under Technology was read as Network.", "handled": "Network and infrastructure controls already exist as a domain in the dataset; nothing depends on the reading."},
    {"n": 3, "text": "The exact count and breakdown of the \"14\" ISO/IEC 42001 items is unconfirmed.", "handled": "Nothing assumes 14. ISO/IEC 42001's own controls are grouped into five streams by a documented rule set you can review."},
    {"n": 4, "text": "The standards listed in the top-right mapping (27001 and others) are unconfirmed.", "handled": "You choose the frameworks per system; any of the 18 in the dataset can be mapped."},
    {"n": 5, "text": "The DORA, ISO 27001 and overall percentages, and what they measure, are unconfirmed.", "handled": "Percentages are computed, never typed, with one stated method; the figures in the notes are not used."},
    {"n": 6, "text": "The meaning of \"TSM\" and of the \"Git, Jenkins\" box is unconfirmed.", "handled": "Remediation is tracked in the findings tracker. CI/CD evidence arrives through the results file contract; there are no connectors."}
  ]
}
