{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EverythingSecurity/AIGovernanceJumbo/main/schema/scope.schema.json",
  "title": "AI Controls Framework - scope file",
  "description": "An organisation's scoping decisions (aicontrols-scope.json). Keep this file private. SPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_version",
    "organization",
    "systems",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "description": "1.1 files may carry the workflow layer, 1.2 the GRC layer (`grc`), 1.3 the client engagement layer (`engagement`), written by `aicontrols workflow`, `aicontrols grc` and `aicontrols engagement`."
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "organization": {
      "type": "string"
    },
    "created": {
      "$ref": "#/$defs/date"
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "frameworks"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "frameworks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "scoping": {
            "type": "object",
            "description": "How the frameworks were chosen (recorded by `aicontrols scope wizard`). A planning record, not a legal determination.",
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "answers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "include_level": {
                "enum": [
                  "recommended",
                  "consider",
                  "custom"
                ]
              },
              "included": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "description": "system id -> control id -> decision. Only explicit decisions are stored; anything absent is applicable and not_started.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/decision"
        }
      }
    },
    "workflow": {
      "type": "object",
      "description": "system id -> workflow state (stage, profile, common controls, measurements, exceptions, policy). Written by `aicontrols workflow`.",
      "additionalProperties": {
        "$ref": "#/$defs/workflow_state"
      }
    },
    "audit": {
      "type": "array",
      "description": "Hash-chained event log: tamper-evident, not immutable.",
      "items": {
        "$ref": "#/$defs/audit_event"
      }
    },
    "grc": {
      "type": "object",
      "description": "Organisation-level GRC registers and settings (written by `aicontrols grc`). Field-level rules are in src/aicontrols/grc_spec.json.",
      "additionalProperties": false,
      "properties": {
        "documents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "risks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "findings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "audits": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "scope_items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "evidence_sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        },
        "settings": {
          "type": "object"
        },
        "framework_scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "statement",
              "reviewed"
            ],
            "properties": {
              "statement": {
                "type": "string"
              },
              "reviewed": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "scope_reviewed": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "markers": {
          "type": "object"
        }
      }
    },
    "engagement": {
      "type": "object",
      "description": "Client engagement: profile, scoping questionnaire answers, applicability rules, recommendations, review and the finalised framework set (written by `aicontrols engagement`). Rules and questions are in src/aicontrols/engagement_spec.json.",
      "additionalProperties": false,
      "properties": {
        "client": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "sector": {
              "type": [
                "string",
                "null"
              ]
            },
            "country": {
              "type": [
                "string",
                "null"
              ]
            },
            "size": {
              "type": [
                "string",
                "null"
              ]
            },
            "contributor": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "invited",
                "onboarded"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "scoping": {
          "type": "object",
          "properties": {
            "questionnaire_version": {
              "type": "integer"
            },
            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "submitted"
              ]
            },
            "responses": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "value",
                  "by",
                  "at"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "array"
                    ]
                  },
                  "by": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  }
                }
              }
            },
            "delegations": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "to"
                ],
                "properties": {
                  "to": {
                    "type": "string"
                  },
                  "due": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "submitted_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "submitted_by": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "rules": {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "custom": {
              "type": "object"
            },
            "disabled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "recommendation": {
          "type": [
            "object",
            "null"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "action",
              "by",
              "at"
            ],
            "properties": {
              "action": {
                "enum": [
                  "accept",
                  "add",
                  "remove"
                ]
              },
              "justification": {
                "type": "string"
              },
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        },
        "applicable": {
          "type": [
            "object",
            "null"
          ]
        },
        "roles": {
          "type": "object",
          "description": "Who holds each engagement role (names are labels). Roles are enforced once anyone holds one.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "packages": {
          "type": "object",
          "description": "One questionnaire per finalised framework, built from the library's controls.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "framework",
              "status",
              "controls",
              "assignments",
              "responses"
            ],
            "properties": {
              "framework": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "open",
                  "submitted"
                ]
              },
              "created_at": {
                "type": "string"
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assignments": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "to"
                  ],
                  "properties": {
                    "to": {
                      "type": "string"
                    },
                    "due": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "by": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    }
                  }
                }
              },
              "responses": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "answer",
                    "status",
                    "by",
                    "at"
                  ],
                  "properties": {
                    "answer": {
                      "enum": [
                        "implemented",
                        "partially_implemented",
                        "not_implemented",
                        "not_applicable"
                      ]
                    },
                    "comment": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "status": {
                      "enum": [
                        "in_progress",
                        "submitted",
                        "returned",
                        "approved"
                      ]
                    },
                    "by": {
                      "type": "string"
                    },
                    "at": {
                      "type": "string"
                    },
                    "shared_from": {
                      "type": "string"
                    },
                    "review": {
                      "type": "object"
                    }
                  }
                }
              },
              "submitted_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "submitted_by": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "justification": {
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "implemented",
            "verified"
          ]
        },
        "due": {
          "$ref": "#/$defs/date"
        },
        "reviewed": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "target": {
          "enum": [
            "implemented",
            "verified"
          ],
          "description": "Target profile for this control (workflow layer)."
        },
        "target_by": {
          "$ref": "#/$defs/date"
        },
        "implementation": {
          "type": "string",
          "description": "Tailored implementation statement (workflow layer)."
        },
        "common_control": {
          "type": "string",
          "description": "Id of the common control this control maps to (workflow layer)."
        },
        "common_control_gap": {
          "type": "string",
          "description": "Reason this control is deliberately not mapped (workflow layer)."
        },
        "mapping_owner": {
          "type": "string",
          "description": "Owner of this requirement-to-control mapping (GRC layer)."
        },
        "mapping_reviewed": {
          "$ref": "#/$defs/date",
          "description": "When this mapping was last reviewed (GRC layer)."
        }
      },
      "if": {
        "properties": {
          "applicable": {
            "const": false
          }
        },
        "required": [
          "applicable"
        ]
      },
      "then": {
        "required": [
          "justification"
        ],
        "properties": {
          "justification": {
            "minLength": 1
          }
        }
      }
    },
    "audit_event": {
      "type": "object",
      "required": [
        "seq",
        "at",
        "actor",
        "role",
        "action",
        "system",
        "target",
        "details",
        "prev",
        "hash"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "prev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "workflow_state": {
      "type": "object",
      "required": [
        "cycle",
        "stage",
        "entered",
        "attestations",
        "profile",
        "common_controls",
        "measurements",
        "escalations",
        "exceptions",
        "markers"
      ],
      "properties": {
        "spec_version": {
          "type": "string"
        },
        "cycle": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "enum": [
            "FRAMEWORK_SCOPING",
            "CONTROL_HARMONIZATION",
            "CONTROL_TAILORING",
            "CONTINUOUS_MONITORING",
            "EXCEPTION_GOVERNANCE",
            "TARGET_GAP_ANALYSIS"
          ]
        },
        "entered": {
          "type": "string"
        },
        "stage_log": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "attestations": {
          "type": "object"
        },
        "profile": {
          "type": "object",
          "properties": {
            "business_unit": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            },
            "boundary": {
              "type": "string"
            },
            "asset_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "risk_appetite": {
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            },
            "target_default": {
              "enum": [
                "implemented",
                "verified"
              ]
            }
          }
        },
        "common_controls": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "title",
              "owner",
              "reviewer",
              "frequency",
              "implementation",
              "evidence_required",
              "test",
              "indicators"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "frequency": {
                "enum": [
                  "daily",
                  "weekly",
                  "monthly",
                  "quarterly",
                  "annual",
                  null
                ]
              },
              "evidence_required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "test": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "manual",
                      "automated",
                      "rcsa",
                      null
                    ]
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "indicators": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "kind",
                    "metric",
                    "breach_if"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "KCI",
                        "KRI"
                      ]
                    },
                    "breach_if": {
                      "type": "object",
                      "required": [
                        "op",
                        "value"
                      ],
                      "properties": {
                        "op": {
                          "enum": [
                            ">",
                            ">=",
                            "<",
                            "<="
                          ]
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "documents": {
                "type": "object",
                "description": "Policy, guideline and SOP ids linked to this control (GRC layer).",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "evidence_sources": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Evidence source ids linked to this control (GRC layer)."
              }
            }
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cc",
              "at",
              "result"
            ],
            "properties": {
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "error"
                ]
              },
              "metrics": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        },
        "escalations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "exceptions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "id",
              "type",
              "reason",
              "requested_by",
              "status",
              "approvals",
              "revision",
              "history"
            ],
            "properties": {
              "type": {
                "enum": [
                  "waiver",
                  "delayed_remediation",
                  "deviation"
                ]
              },
              "status": {
                "enum": [
                  "requested",
                  "assessed",
                  "approved",
                  "rejected",
                  "closed"
                ]
              },
              "assessment": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "approvals": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "expires": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "policy": {
          "type": "object"
        },
        "markers": {
          "type": "object"
        },
        "completed_cycles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
